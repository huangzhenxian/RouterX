# RouteX 生产 .env 模板。复制成 .env 后逐项替换 <REPLACE-ME>。
# 用法：cp .env.prod.example .env && vim .env

# ===== 后端 =====
APP_ENV=prod
APP_PORT=8891
# 至少 32 位强随机，泄露相当于所有 admin 会话被偷
APP_JWT_SECRET=<REPLACE-ME-with-`openssl rand -hex 32`>

# 管理面板可访问的域名（容器内 nginx 反代同源，正常不会触发 CORS，
# 但万一你用 nginx 之外的方式跑前端，这里要对得上）
WEB_ORIGIN=https://admin.yourdomain.com

# 管理面板对外端口（默认 80；80 已占用可改 8080）
WEB_PORT=80

# ===== PostgreSQL =====
# 容器互联时这两行会被 compose 的 environment 覆盖成 postgres / 5432，
# 但本文件里仍要保留默认值给本地 go run 时用。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=routex
POSTGRES_USER=routex
POSTGRES_PASSWORD=<REPLACE-ME-strong-random>

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Xray =====
XRAY_API_HOST=xray
XRAY_API_PORT=10085
XRAY_INBOUND_TAG=vless-in

# ===== 客户端连接信息（订阅链接里写的就是这些） =====
# 必须是公网可达的域名或 IP
PUBLIC_HOST=vpn.yourdomain.com
# 生产建议 443；如果 443 被别的服务占了就保留 8895
PUBLIC_PORT=443

# Reality 密钥：在该 VPS 上跑下面这条得到 PrivateKey 填进
#   deploy/xray/config.json 的 realitySettings.privateKey,
# 把 PublicKey 填到这里：
#   docker run --rm teddysun/xray xray x25519
REALITY_PUBLIC_KEY=<REPLACE-ME-with-xray-x25519-PublicKey>
REALITY_SNI=www.cloudflare.com
REALITY_SHORT_ID=

# ===== 调度器 =====
TRAFFIC_POLL_SECONDS=60
PROVIDER_HEALTH_SECONDS=120

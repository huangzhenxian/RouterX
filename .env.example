# ===== 后端 =====
APP_ENV=dev
APP_PORT=8891
APP_JWT_SECRET=change-me-to-a-long-random-string

# ===== PostgreSQL =====
# 注：Go 后端在宿主机 go run，因此 host 用 127.0.0.1；
# 如果以后把后端也塞进 docker-compose，把 host 换成服务名 postgres / redis / xray。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=8892
POSTGRES_DB=routex
POSTGRES_USER=routex
POSTGRES_PASSWORD=routex_dev_pwd

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=8893
REDIS_PASSWORD=

# ===== Xray =====
XRAY_API_HOST=127.0.0.1
XRAY_API_PORT=8894
XRAY_INBOUND_TAG=vless-in

# 流量轮询间隔（秒），默认 60
TRAFFIC_POLL_SECONDS=60

# ===== 客户端连接信息（订阅链接会用） =====
# 客户端要连的公网地址；本机调试可写 127.0.0.1
PUBLIC_HOST=127.0.0.1
# 客户端要连的 VLESS 端口（生产建议 443，dev 是 8895）
PUBLIC_PORT=8895

# Reality 客户端参数；REALITY_PUBLIC_KEY 由 start.sh 在首启时自动写入
REALITY_PUBLIC_KEY=
REALITY_SNI=www.cloudflare.com
REALITY_SHORT_ID=

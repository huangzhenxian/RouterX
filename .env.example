# ===== 后端 =====
APP_ENV=dev
APP_PORT=8080
APP_JWT_SECRET=change-me-to-a-long-random-string

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=routex
POSTGRES_USER=routex
POSTGRES_PASSWORD=routex_dev_pwd

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Xray =====
XRAY_API_HOST=xray
XRAY_API_PORT=10085
XRAY_INBOUND_TAG=vless-in

# 流量轮询间隔（秒），默认 60
TRAFFIC_POLL_SECONDS=60

# ===== sing-box =====
SINGBOX_API_HOST=sing-box
SINGBOX_API_PORT=9090

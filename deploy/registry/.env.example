# RouteX 服务器部署 .env 模板。复制成 .env 后逐项替换 <REPLACE-ME>。
# 用法:cp .env.example .env && vim .env
# restart.sh 启动前会预检这些必填项,占位符没改会拒绝启动。

# ===== 镜像 =====
# latest = 生产通道(本仓库只推 latest)。也可锁定历史 tag。
IMAGE_TAG=latest

# ===== 后端 =====
# 至少 32 位强随机,泄露相当于所有 admin 会话被偷。生成:openssl rand -hex 32
APP_JWT_SECRET=<REPLACE-ME-with-`openssl rand -hex 32`>

# 管理面板绑定(默认只绑本机回环,对外由 nginx/caddy 反代 80/443 进来)。
# 除非明确要公网直连,否则别把 APP_BIND 改成 0.0.0.0。
APP_BIND=127.0.0.1
APP_PORT=8890

# ===== PostgreSQL =====
POSTGRES_DB=routex
POSTGRES_USER=routex
POSTGRES_PASSWORD=<REPLACE-ME-strong-random>

# ===== 客户端连接信息(订阅链接里写的就是这些) =====
# 必须是公网可达的域名或 IP
PUBLIC_HOST=vpn.yourdomain.com
# 生产建议 443;被占用就保留 8895。注意:这是 VLESS 入站,必须公网可达。
PUBLIC_PORT=8895

# Reality 公钥:在 VPS 上跑下面这条,把 PublicKey 填这里,
# PrivateKey 填进 ./xray/config.json 的 realitySettings.privateKey:
#   docker run --rm teddysun/xray xray x25519
REALITY_PUBLIC_KEY=<REPLACE-ME-with-xray-x25519-PublicKey>
REALITY_SNI=www.cloudflare.com
REALITY_SHORT_ID=

# ===== 调度器 =====
TRAFFIC_POLL_SECONDS=60
PROVIDER_HEALTH_SECONDS=120
